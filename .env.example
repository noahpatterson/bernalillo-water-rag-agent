# OpenAI API Key
OPENAI_API_KEY=sk-proj-1234567890

# A cheap openai model used for development and testing
OPENAI_MODEL_DEV=gpt-5.4-mini

# A strong openai model used for production
OPENAI_MODEL_STRONG=gpt-5.6-luna

# The model tier to use in the application
OPENAI_MODEL_TIER=dev

# The execution provider to use for the onnx model
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider

# The database to use for the application
POSTGRES_HOST=localhost
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Host port for the FastAPI service in docker compose
API_PORT=8000
